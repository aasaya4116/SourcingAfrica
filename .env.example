# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Supabase → Connect → Session pooler (IPv4, works on Railway)
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
# Project URL — used to fetch the JWKS that verifies access tokens.
SUPABASE_URL=https://[REF].supabase.co
# Anon/publishable key. Public by design — the frontend needs it to sign in.
SUPABASE_ANON_KEY=eyJ...
# Only needed if your project still signs JWTs with the legacy shared secret.
# SUPABASE_JWT_SECRET=
# Comma-separated tester allowlist. Leave empty to admit any account that can
# sign in to this Supabase project.
ALLOWED_EMAILS=you@example.com,tester@example.com

# ── Rate limiting (optional; required once >1 instance) ───────────────────────
# Without these the app falls back to an in-process limiter, which is correct
# for a single container and wrong for several.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
ASK_LIMIT_PER_HOUR=30
SUMMARY_LIMIT_PER_HOUR=120

# ── Optional ──────────────────────────────────────────────────────────────────
# CLAUDE_MODEL=claude-opus-5
# RUN_INGESTOR=0        # disable the in-app ingestion scheduler
# ENRICH_ON_INGEST=0    # ingest without model calls; backfill catches up
# AUTH_DISABLED=1       # LOCAL DEVELOPMENT ONLY — never set this in Railway
